function(install_flutter_native_assets PROJECT_BUILD_DIR INSTALL_BUNDLE_LIB_DIR NATIVE_ASSETS_PLATFORM)
  set(NATIVE_ASSETS_DIR "${PROJECT_BUILD_DIR}native_assets/${NATIVE_ASSETS_PLATFORM}/")
  install(DIRECTORY "${NATIVE_ASSETS_DIR}"
    DESTINATION "${INSTALL_BUNDLE_LIB_DIR}"
    COMPONENT Runtime)
endfunction()
